{
  "name": "terc",
  "version": "1.0.0",
  "description": "SiteFarm One subtheme for Drupal",
  "dependencies": {
    "vue": "^3.5.13"
  },
  "main": "vite.config.mjs",
  "private": true,
  "scripts": {
    "start": "npm run dev",
    "dev": "ucd-theme-tasks dev",
    "build": "ucd-theme-tasks build",
    "lint": "ucd-theme-tasks lint",
    "lint:css": "ucd-theme-tasks lint --css",
    "lint:css-fix": "ucd-theme-tasks lint --css --fix",
    "lint:js": "ucd-theme-tasks lint --js",
    "lint:js-fix": "ucd-theme-tasks lint --js --fix",
    "postinstall": "npm run build",
    "typecheck": "vue-tsc --noEmit -p vue/tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "ucd-theme-tasks": "^5.1.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "fast-glob": "^3.3.2",
    "typescript": "~5.6.3",
    "vue-tsc": "^2.1.10",
    "vitest": "^4.1.10",
    "happy-dom": "^20.0.11",
    "@vue/test-utils": "^2.4.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}